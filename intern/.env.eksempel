# Kopier til .env.local og fyll inn. Filen er i .gitignore.

# ── PÅKREVD ──────────────────────────────────────────────────────────────
# Nøkkelen sesjonscookien signeres med. Minst 32 tegn.
# Lag en: openssl rand -base64 48
SESJON_HEMMELIGHET=

# ── GOOGLE WORKSPACE-INNLOGGING ──────────────────────────────────────────
# Fra Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Se LES-MEG.md for oppsett steg for steg.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domenet som slipper inn. Standard er reflektor.no hvis den ikke settes.
TILLATT_DOMENE=reflektor.no

# ── KUN LOKALT ───────────────────────────────────────────────────────────
# Lar deg logge inn uten Google mens du utvikler. Virker ALDRI i en deploy:
# NODE_ENV er production der, og begge betingelsene må holde.
# INTERN_DEV_INNLOGGING=true
