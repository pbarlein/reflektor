{
  "name": "reflektor",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "dev:mobil": "next dev --hostname 0.0.0.0",
    "content:check": "node --experimental-strip-types scripts/content-check.ts",
    "bekreft:check": "node --experimental-strip-types scripts/bekreft-check.ts",
    "lenkesjekk": "node --experimental-strip-types --import ./tests/alias.mjs scripts/lenkesjekk.ts",
    "test": "node --experimental-strip-types --import ./tests/alias.mjs --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "next": "^16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
